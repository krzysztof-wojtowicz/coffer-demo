{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(curl -s http://localhost:*)"
    ],
    "deny": ["Read(./.env)", "Bash(git push:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in */src/backend/*.py) cd \"$CLAUDE_PROJECT_DIR/src/backend\" && uv run --quiet ruff format --quiet \"$f\";; esac; exit 0"
          }
        ]
      }
    ]
  }
}
