# Copy to .env; all variables are optional (defaults shown).
# Database connection URL (SQLAlchemy + psycopg 3). postgres:// and postgresql:// URLs
# (e.g. Neon: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require)
# are accepted as-is and mapped to psycopg 3. See docs/deploy/database.md.
COFFER_DATABASE_URL=postgresql+psycopg://coffer:coffer@localhost:5432/coffer
# Trusted browser origins: Origin check for POST/PUT/PATCH/DELETE (403 otherwise) and, when
# CORS is enabled, CORS. JSON list or comma-separated; scheme://host[:port], no trailing "/".
COFFER_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# Optional regex for extra origins (re.fullmatch, must start with literal https://), e.g.
# Vercel previews: https://cofferai-[a-z0-9-]+-<team>\.vercel\.app  (escape the dots!)
COFFER_ALLOWED_ORIGIN_REGEX=
# CORS for direct cross-origin calls to the API; not needed behind the Vercel rewrite or Vite proxy
COFFER_CORS_ENABLED=false
# Session lifetime in days
COFFER_SESSION_TTL_DAYS=14
# Set true when served over HTTPS
COFFER_COOKIE_SECURE=false
# Session cookie SameSite: lax | strict | none (none = cross-site cookie, needs COFFER_COOKIE_SECURE=true,
# weakens CSRF defence; see docs/deploy/backend.md "CORS i Origin")
COFFER_COOKIE_SAMESITE=lax
# Proxies appending to X-Forwarded-For (login rate limit per IP): 0 locally, 2 for Vercel -> Render (unverified, see docs/deploy/release-checklist.md §6)
COFFER_TRUSTED_PROXY_HOPS=0
# Max parallel Argon2 hashes (memory on 512 MB Render)
COFFER_PASSWORD_HASH_CONCURRENCY=2
# LLM provider: ollama | openai | gemini | anthropic | none
COFFER_LLM_PROVIDER=gemini
COFFER_OLLAMA_URL=http://localhost:11434
COFFER_OLLAMA_MODEL=qwen3:8b
# Only for a remote/hosted Ollama (e.g. COFFER_OLLAMA_URL=https://ollama.com); sent as
# "Authorization: Bearer <key>". Leave empty for a local Ollama.
COFFER_OLLAMA_API_KEY=
# OpenAI (or any OpenAI-compatible API via base URL); used when provider=openai
COFFER_OPENAI_API_KEY=
COFFER_OPENAI_MODEL=gpt-4o-mini
COFFER_OPENAI_BASE_URL=https://api.openai.com/v1
# Google Gemini; used when provider=gemini
COFFER_GEMINI_API_KEY=
COFFER_GEMINI_MODEL=gemini-3.5-flash-lite
# Anthropic Claude; used when provider=anthropic (key: console.anthropic.com -> API Keys)
COFFER_ANTHROPIC_API_KEY=
COFFER_ANTHROPIC_MODEL=claude-sonnet-5-5
COFFER_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Time budget per model call in seconds, retries (429/5xx/timeouts, max 2) included
COFFER_LLM_TIMEOUT_S=90
# Total time budget of one investment-advisor run (all tool-calling steps), 1..109 s; when it
# runs out the advisor returns rule-based picks with ai_status "timeout"
COFFER_ADVISOR_TIMEOUT_S=60
# Optional fallback chain after the primary model, tried when it is unavailable (overloaded,
# 404, no key...): comma list of provider:model, e.g.
# gemini:gemini-3.8-flash,anthropic:claude-haiku-5-5
COFFER_LLM_FALLBACKS=

# Max agent runs per user per day (local model: no cost, protects the machine)
COFFER_AGENT_DAILY_LIMIT=50
# Model calls per suggestion: 1 + retries after failed validation
COFFER_AGENT_MAX_ATTEMPTS=2
